# PostgreSQL connection string (local docker-compose, Supabase, Railway…).
# Quotes are valid in this .env file; omit them when pasting into a hosting dashboard.
DATABASE_URL="postgresql://sgs:sgs@localhost:5432/school_grading?schema=public"

PORT=4000
# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# Secrets — generate strong random values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Optional external notification settings
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@school-grading-system.local
# EMAIL_HOST=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_PORT=587
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_ENABLED=false

# Shown on report cards / transcripts
SCHOOL_NAME="Excellence Model School"
SCHOOL_MOTTO="Knowledge. Integrity. Excellence."
